# Optional. Paths are relative to the repository root.
# Load a private .env copy with Uvicorn's --env-file .env option when needed.
TRACK_MTAANI_DB_PATH=data/track_mtaani.sqlite3
# This first milestone uses reviewed templates and needs no API keys.

# WhatsApp stays disabled until you explicitly enable it and configure all fields.
# Confirm your Twilio account permits custom Sandbox/TwiML replies before enabling.
TRACK_MTAANI_WHATSAPP_ENABLED=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WEBHOOK_URL=
# Number format: whatsapp:+<country-code-and-number>
# URL format: https://<public-host>/api/v1/whatsapp/webhook
